# Apache configuration for Iglesia Eben-Ezer
# Redirect .html requests to .php
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)\.html$ $1.php [L,R=301]

# Protect database directory
<IfModule mod_rewrite.c>
    RewriteRule ^data/ - [F,L]
</IfModule>

# Prevent direct access to .db files
<FilesMatch "\.db$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent direct access to includes
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
</IfModule>
