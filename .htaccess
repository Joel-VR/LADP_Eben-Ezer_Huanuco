# Apache configuration for Iglesia Eben-Ezer (local dev, DocumentRoot=root)
# Production DocumentRoot is public/ — see public/.htaccess
RewriteEngine On

# Protect internals: never serve these directly
RewriteRule ^(src|views|routes|db|scripts|data)/ - [F,L]
RewriteRule ^includes/ - [F,L]

# Prevent direct access to .db files
<FilesMatch "\.db$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block env files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>
